# ==== DJANGO ====
DEBUG=False
SECRET_KEY=your_secret_key_here

# Allowed hosts — когда получишь домен, добавишь его здесь
ALLOWED_HOSTS=localhost,127.0.0.1

# ==== DATABASE (PostgreSQL) ====
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==== Django settings ====
DJANGO_SETTINGS_MODULE=core.settings

# ==== STATIC & MEDIA ====
STATIC_URL=/static/
MEDIA_URL=/media/

# ==== CORS/FRONTEND ====
# Когда у тебя появится домен фронта — добавишь сюда
CORS_ALLOWED_ORIGINS=
