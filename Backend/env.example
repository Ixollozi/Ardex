# ==== DJANGO ====
DEBUG=False
SECRET_KEY=your_secret_key_here_change_in_production

# Allowed hosts - домены для продакшена
ALLOWED_HOSTS=ardex.uz,www.ardex.uz

# ==== DATABASE (PostgreSQL) ====
POSTGRES_DB=ardex
POSTGRES_USER=ardex_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==== Django settings ====
DJANGO_SETTINGS_MODULE=core.settings
SITE_ID=1

# ==== STATIC & MEDIA ====
STATIC_URL=/static/
MEDIA_URL=/media/

# ==== CORS/FRONTEND ====
# Домены фронтенда для CORS
CORS_ALLOWED_ORIGINS=https://ardex.uz,https://www.ardex.uz

# ==== SITEMAP ====
SITEMAP_PROTOCOL=https
SITEMAP_DOMAIN=ardex.uz

# ==== TELEGRAM (опционально) ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==== GOOGLE ANALYTICS (опционально) ====
GOOGLE_ANALYTICS_ID=
